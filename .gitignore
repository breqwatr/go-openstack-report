# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# The compiled tool. A Go binary has no extension, so the patterns above miss
# it; this is BINARY_NAME from the Makefile, built into the repo root.
/reportctl

# Output of the go coverage tool
*.out

# Temporary files
*.tmp
*.temp

# Build directories
bin/
build/

# Vendor directory
vendor/

# Dependency directories (remove the comment if you use Go modules)
# /vendor/

# Go workspace file
go.work
go.work.sum

# IDE/editor directories and files
.vscode/
.idea/
*.swp
*.swo
*.swn
*.bak
*.orig

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Excel reports, and the lock files Excel leaves beside an open one
report-*.xlsx
~$*

# Credentials. These matched only the bare filenames, so a real openrc saved
# under any prefix (admin-openrc.sh, prod-openrc.sh) was committable. Match the
# suffix instead and keep the checked-in template explicitly.
*openrc.sh
*open-rc.sh
!example-open-rc.sh
